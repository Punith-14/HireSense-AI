# ─────────────────────────────────────────────
#  HireSense AI — Unified Environment Config
#  Copy this file to .env and fill in your keys
# ─────────────────────────────────────────────

# ── Django Core ──────────────────────────────
DJANGO_SECRET_KEY=change-this-for-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=Asia/Kolkata

# ── MongoDB ───────────────────────────────────
MONGO_URI=
MONGO_DB_NAME=hiresense_ai
MONGO_ALIAS=default
MONGO_SERVER_SELECTION_TIMEOUT_MS=3000

# ─────────────────────────────────────────────
#  PERSON 1 — Interview Agent APIs
#  (Question Generation + Answer Evaluation)
# ─────────────────────────────────────────────

# Groq API — used for question generation (Llama 3.1 8B Instant)
# and answer evaluation (Llama 3.3 70B Versatile)
# Get your key at: https://console.groq.com
GROQ_API_KEY=

# OpenRouter API — optional fallback evaluation engine
# Get your key at: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# ─────────────────────────────────────────────
#  PERSON 2 — Core AI Engine APIs
#  (Interview Engine, Memory, Evaluation, Reports)
# ─────────────────────────────────────────────

# xAI Grok — primary LLM for adaptive question generation and evaluation
# Get your key at: https://console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-2-latest

# LLM provider settings
LLM_PROVIDER=auto
LLM_TIMEOUT_SECONDS=20
LLM_RETRY_COUNT=3
LLM_FALLBACK_ENABLED=True

# Local HuggingFace model (offline fallback — optional)
HF_LOCAL_ENABLED=False
HF_MODEL=microsoft/Phi-3-mini-4k-instruct
HF_MAX_NEW_TOKENS=512
HF_TEMPERATURE=0.3

# ─────────────────────────────────────────────
#  PERSON 2 — Speech Recognition
# ─────────────────────────────────────────────

# Path to local Vosk model directory for offline speech-to-text
# Download a model from: https://alphacephei.com/vosk/models
VOSK_MODEL_PATH=

# Allow online fallback speech recognition (optional)
ALLOW_ONLINE_SPEECH_RECOGNITION=False
ONLINE_SPEECH_ENDPOINT=
ONLINE_SPEECH_TIMEOUT_SECONDS=25

# ─────────────────────────────────────────────
#  PERSON 2 — Runtime & Task Queue
# ─────────────────────────────────────────────

INFERENCE_WORKERS=2
CELERY_ENABLED=False
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_TIME_LIMIT=120
